{
  "_what": "Multi-provider LLM token pricing. Supersedes largeliterarymodels/data/anthropic_pricing.json, which is Anthropic-only and was last updated 2026-04-27 (it tops out at claude-sonnet-4-6 and cannot price claude-sonnet-5, any OpenAI model, or any DeepSeek model).",
  "unit": "USD per 1,000,000 tokens",
  "fetched": "2026-08-04",
  "sources": {
    "anthropic": "https://platform.claude.com/docs/en/docs/about-claude/pricing",
    "openai": "https://developers.openai.com/api/docs/pricing",
    "deepseek": "https://api-docs.deepseek.com/quick_start/pricing"
  },
  "fields": {
    "input": "fresh (uncached) input tokens",
    "cached": "cache read / cache hit. null means the model has NO cache tier and cached tokens bill at the full `input` rate.",
    "cache_write_5m": "prompt cache write, 5-minute TTL (Anthropic; OpenAI gpt-5.6-* only). null = not offered or not separately billed.",
    "cache_write_1h": "prompt cache write, 1-hour TTL. Anthropic only.",
    "output": "output tokens. For REASONING models this includes reasoning tokens, which are invisible in the response but billed.",
    "reasoning": "true if the model emits billed reasoning tokens \u2014 output-token estimates from a non-reasoning workload are FLOORS for these.",
    "batch_discount": "fraction off input and output for asynchronous batch APIs. Anthropic and OpenAI both offer 0.5."
  },
  "caveats": {
    "anthropic_tokenizer": "Claude 4.7 and later (and Mythos Preview) use a newer tokenizer producing ~30% MORE tokens for the same text. Claude Sonnet 4.6 and earlier use the previous one. Token counts measured on one family do not transfer across that boundary without adjustment.",
    "sonnet_5_introductory": "Claude Sonnet 5 is priced at $2/$10 through 2026-08-31, then $3/$15. Both rows are present; `claude-sonnet-5` aliases the introductory row while it is in force.",
    "openai_long_context": "gpt-5.5, gpt-5.4 and the -pro variants show <272K-context pricing here; longer contexts may be priced differently.",
    "counterfactual_use": "Pricing a workload measured on model A against model B is a COUNTERFACTUAL, not a quote: output volume and tokenization both differ. Price a swap from a small pilot on the target model.",
    "deepseek_peak_pricing": "DeepSeek has ANNOUNCED but not implemented peak/off-peak pricing: during peak hours (09:00-12:00 and 14:00-18:00 Beijing, UTC+8) prices will be 2x. No effective date. Registration P's deepseek arm ran 14:00-15:00 UTC = 22:00-23:00 Beijing, i.e. off-peak, so the $0.81 is a regular-rate figure and would be $1.63 under the announced peak policy.",
    "openai_other_tiers": "The OpenAI page also carries Flex and Fast-mode tables besides Standard and Batch. Only Standard rates are recorded here; a Flex run would price differently."
  },
